# =====================================================================
# ToolzyNet — Hostinger ke liye ready .env
# ---------------------------------------------------------------------
# ISTEMAAL KAISE KAREN:
#  1) Is file ko Hostinger par upload karein (app/ ke saath, public_html
#     ke BAAHAR wale folder me).
#  2) Iska naam badal kar sirf  ".env"  kar dein (dot ke saath).
#  3) Neeche "<< YAHAN BADLEIN >>" wali 4 lines apne hisaab se bhar dein.
# NOTE: Ye file GitHub par hai isliye isme asli password NAHI hai —
#       password aap khud Hostinger wali file me daalein, kabhi share na karein.
# =====================================================================

APP_NAME="ToolzyNet"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOURDOMAIN.com          # << YAHAN BADLEIN: apna domain (https ke saath)
APP_TIMEZONE=Asia/Kolkata

# ---- Database (Hostinger hPanel -> MySQL Databases se milega) ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456_toolzynet               # << YAHAN BADLEIN: poora database naam
DB_USER=u123456_toolzy                  # << YAHAN BADLEIN: database user
DB_PASS=YOUR_DB_PASSWORD                 # << YAHAN BADLEIN: database password
DB_CHARSET=utf8mb4

# ---- Security (APP_KEY pehle se bhar diya hai, ise mat badlein) ----
APP_KEY=b8100a1294a57346f49f3268d1a542cc
SESSION_NAME=toolzynet_session
SESSION_LIFETIME=7200

# ---- Mail / SMTP (abhi optional — baad me bhar sakte hain) ----
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@YOURDOMAIN.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@YOURDOMAIN.com
MAIL_FROM_NAME="ToolzyNet"

# ---- Uploads ----
UPLOAD_MAX_SIZE=3145728
